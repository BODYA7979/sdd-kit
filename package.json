{
  "name": "sdd-kit",
  "version": "3.1.0",
  "private": true,
  "description": "SDD Kit: shared spec-driven workflows, skills and tools for Claude Code and Codex",
  "license": "MIT",
  "repository": "github:stasmarkov/sdd-kit",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "sdd-kit": "cli/sdd-kit.mjs",
    "spec-board": "cli/spec-board.mjs",
    "sdd-kit-board": "cli/spec-board.mjs"
  },
  "files": [
    "cli/",
    "install.sh",
    "VERSION",
    "share/",
    "plugins/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "adapters/",
    "scripts/",
    ".claude-plugin/",
    "docs/"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs --host all",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/build-docs.mjs --check",
    "pretest": "node scripts/build.mjs --host all",
    "test": "node --test tests/*.test.mjs tests/codex/*.test.mjs",
    "test:codex": "node --test tests/codex/*.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "markdown-it": "14.3.3",
    "yaml": "2.9.1"
  }
}
