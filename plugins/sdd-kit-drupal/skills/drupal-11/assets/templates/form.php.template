<?php

declare(strict_types=1);

namespace Drupal\{{MODULE_MACHINE_NAME}}\Form;

use Drupal\Core\Form\ConfigFormBase;
use Drupal\Core\Form\FormStateInterface;

final class {{FORM_CLASS}} extends ConfigFormBase {

  protected function getEditableConfigNames(): array {
    return ['{{MODULE_MACHINE_NAME}}.settings'];
  }

  public function getFormId(): string {
    return '{{MODULE_MACHINE_NAME}}_{{FORM_ID}}';
  }

  public function buildForm(array $form, FormStateInterface $form_state): array {
    $config = $this->config('{{MODULE_MACHINE_NAME}}.settings');

    $form['example_field'] = [
      '#type' => 'textfield',
      '#title' => $this->t('Example field'),
      '#default_value' => $config->get('example_field'),
      '#required' => TRUE,
    ];

    return parent::buildForm($form, $form_state);
  }

  public function submitForm(array &$form, FormStateInterface $form_state): void {
    $this->config('{{MODULE_MACHINE_NAME}}.settings')
      ->set('example_field', $form_state->getValue('example_field'))
      ->save();

    parent::submitForm($form, $form_state);
  }

}
