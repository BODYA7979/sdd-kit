<?php

declare(strict_types=1);

namespace Drupal\{{MODULE_MACHINE_NAME}}\Entity;

use Drupal\Core\Entity\ContentEntityBase;
use Drupal\Core\Entity\EntityChangedTrait;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\user\EntityOwnerTrait;

#[\Drupal\Core\Entity\Attribute\ContentEntityType(
  id: '{{ENTITY_ID}}',
  label: new \Drupal\Core\StringTranslation\TranslatableMarkup('{{ENTITY_LABEL}}'),
  label_collection: new \Drupal\Core\StringTranslation\TranslatableMarkup('{{ENTITY_LABEL_PLURAL}}'),
  handlers: [
    'storage' => \Drupal\Core\Entity\Sql\SqlContentEntityStorage::class,
    'view_builder' => \Drupal\Core\Entity\EntityViewBuilder::class,
    'list_builder' => \Drupal\{{MODULE_MACHINE_NAME}}\Entity\Handler\{{ENTITY_CLASS}}ListBuilder::class,
    'form' => [
      'default' => \Drupal\{{MODULE_MACHINE_NAME}}\Form\{{ENTITY_CLASS}}Form::class,
      'delete' => \Drupal\Core\Entity\ContentEntityDeleteForm::class,
    ],
    'route_provider' => [
      'html' => \Drupal\Core\Entity\Routing\AdminHtmlRouteProvider::class,
    ],
    'access' => \Drupal\{{MODULE_MACHINE_NAME}}\Entity\Handler\{{ENTITY_CLASS}}AccessControlHandler::class,
  ],
  base_table: '{{ENTITY_ID}}',
  data_table: '{{ENTITY_ID}}_field_data',
  translatable: TRUE,
  admin_permission: 'administer {{ENTITY_ID}}',
  entity_keys: [
    'id' => 'id',
    'uuid' => 'uuid',
    'label' => 'title',
    'langcode' => 'langcode',
    'owner' => 'uid',
  ],
  links: [
    'canonical' => '/{{ENTITY_ID}}/{{{ENTITY_ID}}}',
    'add-form' => '/{{ENTITY_ID}}/add',
    'edit-form' => '/{{ENTITY_ID}}/{{{ENTITY_ID}}}/edit',
    'delete-form' => '/{{ENTITY_ID}}/{{{ENTITY_ID}}}/delete',
    'collection' => '/admin/content/{{ENTITY_ID}}',
  ],
)]
final class {{ENTITY_CLASS}} extends ContentEntityBase {

  use EntityChangedTrait;
  use EntityOwnerTrait;

  public static function baseFieldDefinitions(EntityTypeInterface $entity_type): array {
    $fields = parent::baseFieldDefinitions($entity_type);
    $fields += static::ownerBaseFieldDefinitions($entity_type);

    $fields['title'] = BaseFieldDefinition::create('string')
      ->setLabel(t('Title'))
      ->setRequired(TRUE)
      ->setTranslatable(TRUE)
      ->setSetting('max_length', 255)
      ->setDisplayOptions('form', [
        'type' => 'string_textfield',
        'weight' => 0,
      ])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);

    $fields['created'] = BaseFieldDefinition::create('created')
      ->setLabel(t('Created'));

    $fields['changed'] = BaseFieldDefinition::create('changed')
      ->setLabel(t('Changed'));

    return $fields;
  }

}
