{
  "$schema": "../sdd-kit/workflows/lib/stack.schema.json",
  "name": "drupal",
  "order": 20,
  "role": "backend",
  "detect": "composer.json requiring drupal/core (often web/index.php)",
  "agent": {
    "name": "general-purpose"
  },
  "conventions": [
    "module structure",
    "services + dependency injection",
    "plugins",
    "hooks",
    "config schema"
  ],
  "gates": [
    {
      "name": "PHPCS",
      "command": "./vendor/bin/phpcs --standard=Drupal,DrupalPractice",
      "kind": "lint"
    },
    {
      "name": "PHPStan",
      "command": "./vendor/bin/phpstan analyse",
      "kind": "types"
    },
    {
      "name": "PHPUnit",
      "command": "./vendor/bin/phpunit",
      "kind": "test"
    }
  ],
  "debugPatterns": [
    "dd(",
    "dump(",
    "kint(",
    "var_dump("
  ],
  "sourceDirs": [
    "web/modules/custom/",
    "web/themes/custom/",
    "modules/"
  ],
  "acceptance": "exercise the routes/controllers over HTTP",
  "skills": {
    "conventions": [
      "drupal-11"
    ]
  },
  "markers": [
    "core/lib/Drupal.php",
    "web/core/lib/Drupal.php"
  ]
}
