{
  "$schema": "./stack.schema.json",
  "name": "other",
  "order": 1000,
  "role": "fullstack",
  "detect": "no recognized manifest — infer from whatever build/lint/test tooling exists",
  "agent": {
    "name": "general-purpose"
  },
  "conventions": [],
  "gates": [],
  "gateTemplates": [
    {
      "evidence": "package.json",
      "command": "npm run {script}"
    },
    {
      "evidence": "package.json",
      "command": "pnpm run {script}"
    },
    {
      "evidence": "package.json",
      "command": "yarn run {script}"
    },
    {
      "evidence": "package.json",
      "command": "bun run {script}"
    },
    {
      "evidence": "composer.json",
      "command": "composer run-script {script}"
    },
    {
      "evidence": "Makefile",
      "command": "make {script}"
    },
    {
      "evidence": "justfile",
      "command": "just {script}"
    }
  ],
  "debugPatterns": [
    "console.log(",
    "dd(",
    "print("
  ],
  "acceptance": "run whatever entrypoint / tests the project provides"
}
