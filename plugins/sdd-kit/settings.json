{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(jq:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(php artisan migrate --pretend:*)",
      "Bash(./vendor/bin/phpstan analyse:*)",
      "Bash(./vendor/bin/pint --test:*)",
      "Bash(./vendor/bin/pest:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm tsc --noEmit:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(composer show:*)",
      "Bash(composer outdated:*)",
      "Bash(composer audit:*)",
      "Bash(npm outdated:*)",
      "Bash(npm audit:*)",
      "Bash(pnpm outdated:*)",
      "Bash(pnpm audit:*)",
      "Bash(php artisan route:list:*)",
      "Bash(php artisan about:*)",
      "Bash(git fetch:*)",
      "Bash(tsc --noEmit:*)",
      "Bash(npx tsc --noEmit:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(chmod 000:*)",
      "Bash(mysql -e drop:*)",
      "Bash(psql -c drop:*)"
    ]
  },
  "env": {
    "CLAUDE_BUDGET_THRESHOLD": "75"
  }
}
