{
  "description": "SDD Kit {{TITLE}} add-on hooks",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/{{NAME}}-lint.sh",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ]
  }
}
